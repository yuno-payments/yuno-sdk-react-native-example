<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 
        ⚠️ CONFIGURACIÓN PARA TESTING CON PROXYMAN ⚠️
        
        Esta configuración permite interceptar tráfico HTTPS en builds de RELEASE
        para testing con Proxyman.
        
        🚨 NO USAR EN PRODUCCIÓN REAL 🚨
        Esta configuración es INSEGURA para apps en producción porque permite
        ataques man-in-the-middle al confiar en certificados de usuario.
        
        Solo usar para:
        - Testing interno con Proxyman
        - QA y debugging
        - Desarrollo
    -->
    
    <!-- 
        Configuración base: Se aplica a TODAS las builds (debug y release)
        Permite certificados de usuario para que Proxyman funcione en release builds
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Confía en certificados del sistema -->
            <certificates src="system" />
            <!-- ⚠️ Confía en certificados de usuario (NECESARIO para Proxyman en release) -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    
    <!-- 
        Configuración para DEBUG
        Redundante con base-config, pero mantiene consistencia
    -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
